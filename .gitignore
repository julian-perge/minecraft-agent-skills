# Node
node_modules/
npm-debug.log*

# Editor
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log

# Agent workflow scratch
tasks/

# Secrets and local environment
.env
.env.*
.secrets
.secrets.*
*.key
*.pem
*.p12
*.pfx
*.crt

# This repo intentionally versions compatibility mirrors in these root folders.
# Git must track them even when a contributor's global ignore rules list .codex or .claude.
!/.codex/
!/.codex/**
!/.claude/
!/.claude/**

# OS
# These rules come after the mirror rules, because a later rule wins and the mirror rules would include these files again.
.DS_Store
Thumbs.db
